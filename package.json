{
  "name": "toon-checkout",
  "version": "0.1.0",
  "description": "A per-call USDC checkout in front of any HTTP API, on TOON. One manifest of priced doors drives the connector routes, a forwarder that holds the upstream API key, an x402 gate for callers without a channel, and an MCP shim so Claude can pay per call.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "toon-checkout": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx src/*.test.ts",
    "cli": "tsx src/cli.ts",
    "forwarder": "node dist/cli.js forwarder",
    "gate": "node dist/cli.js gate",
    "dev:forwarder": "tsx src/cli.ts forwarder",
    "dev:gate": "tsx src/cli.ts gate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@toon-protocol/client": "^2.1.1",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.3.0",
    "@x402/express": "^2.25.0",
    "@x402/fetch": "^2.3.0",
    "express": "^5.2.1",
    "viem": "^2.21.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drew-dot-com/toon-checkout.git"
  },
  "keywords": [
    "toon",
    "ilp",
    "x402",
    "mcp",
    "checkout",
    "micropayments"
  ]
}

# Public hosts Caddy serves (must resolve to this box). sslip.io works on day one.
PUBLIC_HOST=api.1-2-3-4.sslip.io
GATE_HOST=pay.1-2-3-4.sslip.io

# Your API's credential. Only the forwarder holds it.
UPSTREAM_API_KEY=cm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which manifest (path inside the image; examples/ is copied in).
DOORS=examples/colour-memory/doors.json

# Where x402 revenue lands (a Base address you control; the settlement key's
# address from `first-run.sh` is a fine choice, so both revenue streams meet).
PAY_TO=0x0000000000000000000000000000000000000000

# Redeem claims on chain: dry run until you flip this to 1.
REDEEM_EXECUTE=0
REDEEM_EVERY_HOURS=24
# Do not redeem under this many base units (0.10 USDC): a redeem is one Base tx.
REDEEM_MIN_UNITS=100000

# Optional
# CONNECTOR_IMAGE=ghcr.io/toon-protocol/connector:rust-sha-deded9f
# GATE_MARGIN=1.2
# GATE_FLOOR_USDC=0.005
# CHANNEL_DEPOSIT=2000000
# BASE_RPC=https://base-rpc.publicnode.com
